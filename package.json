{
  "name": "azure-devops-task-utils",
  "version": "6.0.0",
  "description": "Utility library for Azure DevOps tasks",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/**/*"
  ],
  "scripts": {
    "test": "jest --coverage",
    "build": "tsc",
    "prebuild": "rimraf ./lib",
    "format": "prettier --config .prettierrc 'src/**/*.ts' --write",
    "lint": "eslint . --ext .ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/davidpolaniaac/azure-devops-task-utils.git"
  },
  "keywords": [
    "azure",
    "devops",
    "tasks",
    "utils"
  ],
  "author": "davidpolaniaac",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/davidpolaniaac/azure-devops-task-utils/issues"
  },
  "homepage": "https://github.com/davidpolaniaac/azure-devops-task-utils.git#readme",
  "dependencies": {
    "azure-devops-node-api": "^17.0.0",
    "azure-pipelines-task-lib": "^5.279.0",
    "polallel": "^1.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.2",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^30.5.1",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3"
  }
}
